# Convex Backend Environment Variables

# Convex Deployment Identifier
CONVEX_DEPLOYMENT="dev:your-deployment-name"

# Convex Deployment URL
CONVEX_URL="https://your-deployment-name.convex.cloud"

# Site URL for OAuth redirects (Convex Auth)
SITE_URL="http://localhost:3000"

# Google OAuth credentials — required for Convex Auth Google provider
# Get from Google Cloud Console: APIs & Services → Credentials → OAuth Client ID (Web)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Convex Auth uses SITE_URL + AUTH_GOOGLE_* to mount OAuth routes at
# https://<deployment>.convex.site/api/auth/* (see convex/http.ts).
# Set via: bunx --cwd packages/backend convex env set AUTH_GOOGLE_ID <value>
#          bunx --cwd packages/backend convex env set AUTH_GOOGLE_SECRET <value>
#          bunx --cwd packages/backend convex env set SITE_URL http://localhost:3000
# Verify:  bunx --cwd packages/backend convex env list
