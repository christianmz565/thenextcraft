# Next.js Frontend Environment Variables

# Node environment
NODE_ENV="development"

# Convex deployment URL for client-side connection
# Cloud:
NEXT_PUBLIC_CONVEX_URL="https://your-deployment-name.convex.cloud"
# Self-hosted (uncomment when self-hosting; see docker-compose.yml + packages/backend/README.md):
# NEXT_PUBLIC_CONVEX_URL="http://127.0.0.1:3210"
# CONVEX_SELF_HOSTED_URL="http://127.0.0.1:3210"
# CONVEX_SELF_HOSTED_ADMIN_KEY="<from docker compose exec backend ./generate_admin_key.sh>"

# Site URL for OAuth redirects (must match backend SITE_URL)
SITE_URL="http://localhost:3000"
# For self-hosted, Google redirect URI is http://127.0.0.1:3211/api/auth/callback/google
# (CONVEX_SITE_ORIGIN). For cloud, it's https://<deployment>.convex.site/api/auth/callback/google
