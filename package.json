{
  "name": "thenextcraft",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:ci": "biome ci .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "convex:dev": "bun --filter backend convex dev",
    "convex:codegen": "bun --filter backend convex codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.1.0"
  }
}
