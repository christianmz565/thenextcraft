{
  "name": "thenextcraft",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:ci": "biome ci .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "convex:dev": "bun --env-file=.env.dev run --filter backend dev",
    "convex:codegen": "bun --env-file=.env.dev run --filter backend codegen",
    "convex:admin-key": "./scripts/generate-admin-key.sh",
    "dev:web": "bun --env-file=.env.dev run --filter web dev",
    "dev:backend": "bun --env-file=.env.dev run --filter backend dev",
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:web\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.1.0"
  }
}
