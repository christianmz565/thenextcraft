# Root / Monorepo Environment Variables Example
# Copy to .env or .env.local as needed

# --- Frontend (apps/web) ---
# Node environment
NODE_ENV="development"
# Convex deployment URL for Next.js frontend
NEXT_PUBLIC_CONVEX_URL="https://your-deployment-name.convex.cloud"
# Site URL for OAuth redirects (Convex Auth)
SITE_URL="http://localhost:3000"

# --- Backend (packages/backend) ---
# Convex Deployment Identifier (cloud)
CONVEX_DEPLOYMENT="dev:your-deployment-name"
# Convex Deployment URL (cloud)
CONVEX_URL="https://your-deployment-name.convex.cloud"
# Self-hosted alternative (uncomment when self-hosting; see packages/backend/README.md)
# CONVEX_SELF_HOSTED_URL="http://127.0.0.1:3210"
# CONVEX_SELF_HOSTED_ADMIN_KEY="<from docker compose exec backend ./generate_admin_key.sh>"
# Google OAuth credentials (Convex Auth — Google provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Note: For self-hosted, sync AUTH_* and SITE_URL into the self-hosted Convex backend
# using `bun run convex:admin-key` or `convex env set` with --url and --admin-key.
